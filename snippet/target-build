ZLIB_BUILD() {
    mkdir -p $BUILD_DIR/zlib && cd $BUILD_DIR/zlib
    curl --fail -Ls --retry 5 --retry-all-errors --retry-delay 3 -o /tmp/dl.pkg "$ZLIB" && tar zxvf /tmp/dl.pkg --strip-components=1 && rm -f /tmp/dl.pkg
    ./configure \
        --prefix=$PREFIX \
        --static
    make -j$(nproc)
    make install
}

