ARIA2_BUILD() {
    ARIA2_CODE_GET
    # OpenSSL 已用 no-module 把 legacy provider 编进 libcrypto.a，无需外部 .so
    ./configure \
        --prefix=${ARIA2_PREFIX:-'/usr/loacl'} \
        --with-libz \
        --with-libcares \
        --with-libexpat \
        --without-libxml2 \
        --without-libgcrypt \
        --with-openssl \
        --without-libnettle \
        --without-gnutls \
        --without-libgmp \
        --with-libssh2 \
        --with-sqlite3 \
        --without-jemalloc \
        --with-ca-bundle='/etc/ssl/certs/ca-certificates.crt' \
        ARIA2_STATIC=yes \
        --disable-shared
    make -j$(nproc)
}
